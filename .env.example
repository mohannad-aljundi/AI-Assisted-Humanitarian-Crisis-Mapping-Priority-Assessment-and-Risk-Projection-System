# =============================================================================
# Environment template — copy to .env (and optionally .env.local) and fill in.
# Never commit real API keys, database passwords, or tokens.
# =============================================================================

# --- Database (Supabase PostgreSQL / any Postgres) ---
# DATABASE_URL: pooled connection (Transaction pooler, port 6543)
# DIRECT_URL: used for Prisma migrations (port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- LLM providers ---
# Primary provider (default: openai). Gemini and OpenRouter are fallbacks.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
# OPENROUTER_HTTP_REFERER=""
# OPENROUTER_APP_TITLE=""

# --- Background worker ---
# Prefer a separate process so analysis does not block the web UI:
#   Terminal 1: npm run dev
#   Terminal 2: npm run worker
#
# Optional: run a lightweight in-process worker in the Next.js app instead
# DEMO_MODE="true"
# ALLOW_IN_PROCESS_WORKER="true"
# WORKER_CONCURRENCY="1"
# DISABLE_MASTER_INTELLIGENCE_DURING_DEMO="true"

# --- Optional: worker → app cache invalidation ---
# APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# PORT="3000"

# --- Optional: scheduled ingestion endpoint auth ---
# CRON_SECRET=""

# --- Optional: pipeline auto-migration after upgrade ---
# PIPELINE_AUTO_MIGRATE="true"
# PIPELINE_AUTO_MIGRATE_DELAY_MS="120000"

# --- Optional: GeoNames location validation ---
# GEONAMES_USERNAME=""

# --- Optional: SQL query logging ---
# DEBUG_SQL="true"

# --- Optional: additional performance timing logs ---
# DEBUG_PERF="true"

# --- Optional: show detailed technical warnings in the UI ---
# NEXT_PUBLIC_SHOW_TECHNICAL_DETAILS="true"

# --- Ingestion sources ---
# GDELT (default; no API key)
GDELT_API_BASE_URL="https://api.gdeltproject.org/api/v2/doc/doc"

# ReliefWeb — set APPROVED=true only after registering an appname
# https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME="your-reliefweb-appname"
RELIEFWEB_APPNAME_APPROVED="false"
RELIEFWEB_API_BASE_URL="https://api.reliefweb.int/v2/reports"

# NewsAPI — https://newsapi.org/register
NEWS_API_KEY=""

# The Guardian Open Platform — https://open-platform.theguardian.com/access/
# GUARDIAN_API_KEY=""

# ACLED — https://acleddata.com/
# ACLED_EMAIL=""
# ACLED_API_KEY=""

# HDX, GDACS, USGS, NASA EONET, UN News and several RSS feeds need no API key
